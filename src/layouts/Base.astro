---
import { Font, type CssVariable } from 'astro:assets';
import '../styles/global.css';
import AvisoCookies from '../components/AvisoCookies.astro';
import Revelar from '../components/Revelar.astro';
import { temRastreamento } from '../lib/consentimento.ts';
import { pilhaComFontes, variavelFonte } from '../lib/fontes.ts';
import { ancoraSecao, pilhasDoTema, type Conteudo } from '../lib/schema.ts';
import { ALTURA_OG, CAMINHO_OG, chamadaPrincipal, LARGURA_OG, localeOg, urlAbsoluta } from '../lib/seo.ts';

interface Props {
  conteudo: Conteudo;
  titulo?: string;
  descricao?: string;
}

const { conteudo, titulo = conteudo.site.titulo, descricao = conteudo.site.descricao } = Astro.props;
const { tema, rastreamento } = conteudo;

const pilhas = pilhasDoTema(tema);
const variaveisTema = [
  `--cor-fundo:${tema.cor_fundo}`,
  `--cor-superficie:${tema.cor_superficie}`,
  `--cor-texto:${tema.cor_texto}`,
  `--cor-texto-suave:${tema.cor_texto_suave}`,
  `--cor-primaria:${tema.cor_primaria}`,
  `--cor-primaria-contraste:${tema.cor_primaria_contraste}`,
  `--cor-destaque:${tema.cor_destaque}`,
  `--cor-destaque-frio:${tema.cor_destaque_frio}`,
  `--cor-spray:${tema.cor_spray}`,
  // Paint and sticker colors: fixed, so art keeps its color inside the cream band too.
  `--tinta-ambar:${tema.cor_primaria}`,
  `--tinta-menta:${tema.cor_destaque_frio}`,
  `--tinta-escura:${tema.cor_fundo}`,
  `--tinta-creme:${tema.cor_creme}`,
  `--adesivo-rosa:${tema.cor_adesivo_rosa}`,
  `--adesivo-azul:${tema.cor_adesivo_azul}`,
  `--adesivo-lima:${tema.cor_adesivo_lima}`,
  // Fixed values for the cream band, which redefines the --cor-* variables inside it.
  `--creme-fundo:${tema.cor_creme}`,
  `--creme-texto:${tema.cor_creme_texto}`,
  `--creme-texto-suave:${tema.cor_creme_texto_suave}`,
  `--creme-primaria:${tema.cor_creme_primaria}`,
  `--fonte-titulo:${pilhaComFontes(tema.fonte_titulo, tema.fontes, pilhas)}`,
  `--fonte-texto:${pilhaComFontes(tema.fonte_texto, tema.fontes, pilhas)}`,
  `--fonte-tinta:${pilhaComFontes(tema.fonte_tinta, tema.fontes, pilhas)}`,
  `--fonte-mono:${tema.fonte_mono}`,
].join(';');

const menu = conteudo.secoes
  .filter((secao) => secao.ativo && secao.menu)
  .map((secao) => ({ texto: secao.menu, href: `/#${ancoraSecao(secao)}` }));
const contato = conteudo.secoes.find((secao) => secao.tipo === 'contato' && secao.ativo);

// Open Graph and canonical need absolute URLs, so they depend on site.url.
const canonica = urlAbsoluta(conteudo.site.url, Astro.url.pathname);
const imagemOg = urlAbsoluta(conteudo.site.url, CAMINHO_OG);
const altOg = `${conteudo.site.nome}, ${chamadaPrincipal(conteudo)}: guitarra Les Paul sunburst e pedais Zoom`;
---

<!doctype html>
<html lang={conteudo.site.idioma} style={variaveisTema} data-animacoes={tema.animacoes}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="theme-color" content={tema.cor_fundo} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonica && <link rel="canonical" href={canonica} />}
    {canonica && <link rel="sitemap" href="/sitemap-index.xml" />}
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={conteudo.site.nome} />
    <meta property="og:locale" content={localeOg(conteudo.site.idioma)} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    {canonica && <meta property="og:url" content={canonica} />}
    {
      imagemOg && (
        <>
          <meta property="og:image" content={imagemOg} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content={String(LARGURA_OG)} />
          <meta property="og:image:height" content={String(ALTURA_OG)} />
          <meta property="og:image:alt" content={altOg} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    {/* Self-hosted at build time (astro.config.mjs reads tema.fontes); preloaded, with metric-matched fallbacks. */}
    {tema.fontes.map((fonte) => <Font cssVariable={variavelFonte(fonte.familia) as CssVariable} preload />)}
    {conteudo.em_construcao && <meta name="robots" content="noindex" />}
    <slot name="head" />
  </head>
  <body class="grao">
    {/*
      "Roughen" filter for spray and stamp edges (global.css, .aspero): low-frequency noise nudges
      the glyph outlines a couple of pixels. Static, so it is rendered once.
    */}
    <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
      <filter id="aspero" x="-5%" y="-10%" width="110%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.04 0.09" numOctaves="2" seed="7" result="ruido" />
        <feDisplacementMap in="SourceGraphic" in2="ruido" scale="3.5" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[70] focus:rounded focus:bg-fundo focus:px-4 focus:py-2"
    >
      Pular para o conteúdo
    </a>
    {/* Early in the tab order; GA4 and the Meta Pixel load only after "Aceitar". */}
    {temRastreamento(rastreamento) && <AvisoCookies conteudo={conteudo} />}

    {
      conteudo.em_construcao && (
        <aside aria-label="Aviso de site em construção" class="bg-primaria px-4 py-2 text-center text-sm text-primaria-contraste">
          <p>
            <strong>Site em construção.</strong> Algumas partes ainda estão sendo preenchidas.
          </p>
        </aside>
      )
    }

    <header class="sticky top-0 z-40 border-b border-texto/10 bg-fundo/85 backdrop-blur-md">
      <div class="container-site flex h-16 items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5 font-tinta text-2xl">
          <span class="equalizador text-primaria" aria-hidden="true">
            <span style="--i:0;--h:.5"></span><span style="--i:1;--h:.9"></span><span style="--i:2;--h:.65"></span>
          </span>
          {conteudo.site.nome}
        </a>
        {
          menu.length > 0 && (
            <nav aria-label="Principal" class="hidden lg:block">
              <ul class="flex gap-7 text-sm font-bold">
                {menu.map((item) => (
                  <li>
                    <a href={item.href} class="link-menu text-texto-suave hover:text-texto">
                      {item.texto}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        {
          contato && (
            <a href={`/#${ancoraSecao(contato)}`} class="botao-primario min-h-10 px-5 py-2 text-sm">
              Contato
            </a>
          )
        }
      </div>
    </header>

    {/* tabindex lets the skip link move focus, not just scroll, into the content. */}
    <main id="conteudo" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <slot name="depois" />
    {tema.animacoes === 'sutil' && <Revelar />}
  </body>
</html>
