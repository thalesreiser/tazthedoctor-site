---
import Icone from './Icone.astro';
import Adesivo from './arte/Adesivo.astro';
import TituloSecao from './TituloSecao.astro';
import { linkEmail } from '../lib/email.ts';
import { ancoraSecao, type Conteudo, type SecaoDo } from '../lib/schema.ts';

interface Props {
  secao: SecaoDo<'contato'>;
  conteudo: Conteudo;
  rotulo: string;
}

const { secao, conteudo, rotulo } = Astro.props;
const ancora = ancoraSecao(secao);
const idTitulo = `${ancora}-titulo`;
const { email, assunto_email } = conteudo.contato;
---

{/* Contact by e-mail only: no form, no third-party service, nothing sent from the page. */}
<section id={ancora} class="secao brilho-palco parede" aria-labelledby={idTitulo}>
  <div class="container-site relative grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
    {/* Starburst sticker on the wall, by the title (content/site.json, contato.adesivos). */}
    {secao.adesivos[0] && <Adesivo adesivo={secao.adesivos[0]} class="absolute -top-12 right-2 w-28 sm:right-6 sm:w-32 lg:right-auto lg:left-[calc(52%-3.5rem)]" giro={-10} />}
    <div data-revelar-grupo>
      <TituloSecao id={idTitulo} rotulo={rotulo} titulo={secao.titulo} subtitulo={secao.texto} />
    </div>
    <div class="cartao p-6 sm:p-8" data-revelar-grupo>
      {
        secao.topicos.length > 0 && (
          <ul class="space-y-3">
            {secao.topicos.map((topico) => (
              <li class="flex items-center gap-3 text-lg font-bold">
                <span class="h-0.5 w-5 bg-primaria" aria-hidden="true" />
                {topico}
              </li>
            ))}
          </ul>
        )
      }
      <a href={linkEmail(email, assunto_email)} class="botao-primario mt-8 w-full sm:w-auto">
        <Icone nome="email" class="size-5 shrink-0" />
        {secao.texto_email}
      </a>
      <p class="mt-4 font-mono text-sm break-all text-texto-suave">{email}</p>
    </div>
  </div>
</section>
