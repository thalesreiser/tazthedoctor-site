{/*
  Scroll reveal (global.css, .revelar and .anima). Progressive: content is visible by default and only this
  script hides it, skipping the hero, anything already on screen and reduced motion. Children of
  [data-revelar-grupo] enter one after another (--i). Rendered only with tema.animacoes "sutil".
  No layout reads: a first IntersectionObserver pass (asynchronous, no forced reflow) sorts what is
  already on screen from what is below the fold, and only the latter is hidden and revealed later.
*/}
<script>
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Reveal when in view: .revelado for text blocks, .anima-visto for street art.
    const revelar = (classe: string, margem: string) =>
      new IntersectionObserver(
        (entradas, observador) => {
          for (const entrada of entradas) {
            if (!entrada.isIntersecting) continue;
            entrada.target.classList.add(classe);
            observador.unobserve(entrada.target);
          }
        },
        { rootMargin: margem },
      );
    const blocos = revelar('revelado', '0px 0px -8% 0px');
    const arte = revelar('anima-visto', '0px 0px -12% 0px');

    // First pass: below the fold, hide and hand over to the reveal observer; on screen, leave it alone.
    const triagem = new IntersectionObserver((entradas) => {
      for (const { target, isIntersecting } of entradas) {
        triagem.unobserve(target);
        if (isIntersecting) continue;
        const el = target as HTMLElement;
        if (el.hasAttribute('data-anima')) {
          el.classList.add('anima');
          arte.observe(el);
          continue;
        }
        const grupo = el.parentElement!;
        const ordem = grupo.hasAttribute('data-revelar-grupo') ? [...grupo.children].indexOf(el) : 0;
        el.style.setProperty('--i', String(Math.min(ordem, 5)));
        el.classList.add('revelar');
        blocos.observe(el);
      }
    });
    const textos = [...document.querySelectorAll<HTMLElement>('main section:not([data-hero]) :is(.container-site, [data-revelar-grupo]) > *')].filter(
      (el) => !el.hasAttribute('data-revelar-grupo') && !el.hasAttribute('data-anima'),
    );
    // Street art (tags, doodles, stickers, torn edges): drawn, slapped on or dripped once in view.
    const pecas = document.querySelectorAll<HTMLElement>('[data-anima]');
    for (const el of [...textos, ...pecas]) triagem.observe(el);
  }
</script>
