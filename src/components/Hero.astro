---
import Imagem from './Imagem.astro';
import Adesivo from './arte/Adesivo.astro';
import Rabisco from './arte/Rabisco.astro';
import { ancoraSecao, type SecaoDo } from '../lib/schema.ts';

interface Props {
  secao: SecaoDo<'hero'>;
}

const { secao } = Astro.props;
// "TazTheDoctor" -> "Taz" over "TheDoctor", both in dripping paint: "Taz" in spray yellow with a
// misregistered lime copy and extra drips, "TheDoctor" on a strip of torn white paper. Names that
// do not split into capitalized words stay whole.
const partes = secao.titulo.match(/[A-Z][a-z]+/g);
const [tinta, tag] = partes && partes.length > 1 && partes.join('') === secao.titulo ? [partes[0]!, partes.slice(1).join('')] : ['', secao.titulo];
// Sticker slots around the photo: top-right corner, bottom-right, top-left.
const slots = [
  { class: '-top-9 -right-2 w-28 sm:-right-9 sm:w-36', giro: 12 },
  { class: '-bottom-5 right-4 w-24 sm:w-28', giro: 5 },
  { class: '-top-6 -left-6 w-16 sm:w-20', giro: -14 },
];
// Extra paint drips under "Taz" (left %, length in em), on top of the font's own.
const pingosNome = [
  { x: 19, c: 0.3 },
  { x: 54, c: 0.18 },
  { x: 83, c: 0.36 },
];
// Marker notes around the photo: under the bottom-right corner, then beside the top-left one.
const lugaresAnotacao = ['anotacao-baixo', 'anotacao-lado'];
const externo = (href: string) => /^https?:/.test(href);
---

<section id={ancoraSecao(secao)} class="brilho-palco relative overflow-hidden" data-hero aria-label={secao.titulo}>
  {/* Huge faded "Taz" pasted behind the photo side (large screens only). */}
  {tinta && <span class="taz-fantasma" aria-hidden="true">{tinta}</span>}
  <div class="container-site relative grid items-center gap-14 pt-12 pb-20 sm:pt-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:pt-20 lg:pb-24">
    <div class="entrada">
      {secao.selo && <p class="rotulo-mono" style="--i:0">{secao.selo}</p>}
      {/* The visual name is split in two fonts; screen readers get the name once, whole. */}
      <h1 class="nome-hero mt-9" style="--i:1">
        <span class="sr-only">{secao.titulo}</span>
        <span aria-hidden="true" class="relative block">
          {/* Hand-drawn music staff behind the name, with three loose notes. */}
          <svg class="pauta-hero" viewBox="0 0 700 80" focusable="false">
            <g class="pauta-linhas">
              {[0, 12, 24, 36, 48].map((y) => <path d={`M0 ${14 + y}c120-6 300 6 420-2s180 4 280 0`} />)}
            </g>
            <g class="pauta-notas">
              <ellipse cx="480" cy="46" rx="6" ry="4.5" transform="rotate(-20 480 46)" />
              <path d="M485.5 44v-34" />
              <ellipse cx="520" cy="34" rx="6" ry="4.5" transform="rotate(-20 520 34)" />
              <path d="M525.5 32v-34l-40 12" />
              <ellipse cx="600" cy="24" rx="6" ry="4.5" transform="rotate(-20 600 24)" />
              <path d="M605.5 22v-30c8 4 12 10 8 18" />
            </g>
          </svg>
          {
            tinta && (
              <span class="nome-tinta glitch" data-texto={tinta}>
                <span class="nome-registro">{tinta}</span>
                {tinta}
                <Rabisco nome="coroa" class="nome-coroa" />
                {pingosNome.map((p, i) => (
                  <span class="pingo-nome" style={`left:${p.x}%;--comprimento:${p.c}em;--i:${i}`} />
                ))}
              </span>
            )
          }
          <span class="nome-tag-linha block"><span class="nome-tag glitch" data-texto={tag}>{tag}</span></span>
        </span>
      </h1>
      <p class="mt-6 flex items-center gap-3 font-titulo text-2xl text-destaque uppercase sm:text-3xl" style="--i:2">
        <span class="equalizador" aria-hidden="true">
          {[0.5, 0.9, 0.35, 0.75, 0.6].map((h, i) => <span style={`--i:${i};--h:${h}`} />)}
        </span>
        {secao.apelido}
      </p>
      <p class="mt-6 max-w-xl text-lg text-texto-suave sm:text-xl" style="--i:3">{secao.subtitulo}</p>
      {
        secao.etiquetas.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2" style="--i:4" aria-label="Áreas">
            {secao.etiquetas.map((etiqueta) => (
              <li class="etiqueta">{etiqueta}</li>
            ))}
          </ul>
        )
      }
      <div class="mt-9 flex flex-col gap-3 sm:flex-row" style="--i:5">
        <a href={secao.acao_principal.href} class="botao-primario" {...(externo(secao.acao_principal.href) ? { target: '_blank', rel: 'noopener' } : {})}>
          {secao.acao_principal.texto}
        </a>
        {
          secao.acao_secundaria && (
            <a href={secao.acao_secundaria.href} class="botao-secundario" {...(externo(secao.acao_secundaria.href) ? { target: '_blank', rel: 'noopener' } : {})}>
              {secao.acao_secundaria.texto}
            </a>
          )
        }
      </div>
    </div>
    <div class="colagem-hero relative mx-auto w-full max-w-sm lg:max-w-md">
      {/* Layers of torn rolling paper behind the photo, and its yellow offset shadow: decorative. */}
      <div class="seda seda-caramelo" aria-hidden="true"></div>
      <div class="seda seda-vermelha" aria-hidden="true"></div>
      <div class="absolute -inset-10 rounded-full bg-primaria/20 blur-3xl" aria-hidden="true"></div>
      {/* Hand-cut photocopied poster: duotone in the palette (global.css, .foto-poster), taped at the top. */}
      <div class="fita-cantos -rotate-[2deg]">
        <div class="sombra-recorte" aria-hidden="true"></div>
        <div class="foto-poster foto-recortada relative">
          <Imagem
            imagem={secao.foto}
            prioridade
            sizes="(min-width: 1024px) 28rem, (min-width: 640px) 24rem, calc(100vw - 2rem)"
            larguras={[360, 540, 720, 828]}
            class="relative aspect-[3/4] w-full object-cover"
          />
          <span class="reticula-camada" aria-hidden="true"></span>
        </div>
      </div>
      {/* Cassette tape unspooling from the bottom-right corner. */}
      <svg class="fita-cassete" viewBox="0 0 180 200" aria-hidden="true" focusable="false">
        <path class="fita-cassete-corpo desenha" pathLength="1" d="M6 6c40 20 20 60 60 70s50-40 80-10 0 80 30 120" />
        <path class="fita-cassete-brilho desenha" pathLength="1" d="M6 6c40 20 20 60 60 70s50-40 80-10 0 80 30 120" />
      </svg>
      {
        secao.tarja && (
          <div class="tarja-hero" aria-hidden="true">
            <span class="tarja-titulo">{secao.tarja.titulo}</span>
            <span class="tarja-texto">{secao.tarja.texto}</span>
          </div>
        )
      }
      {secao.anotacoes.slice(0, lugaresAnotacao.length).map((anotacao, i) => <p class:list={['anotacao', lugaresAnotacao[i]]} aria-hidden="true">{anotacao}</p>)}
      {/* Stickers slapped around the photo (content/site.json, hero.adesivos): decoration only. */}
      {secao.adesivos.slice(0, slots.length).map((adesivo, i) => <Adesivo adesivo={adesivo} class={`absolute ${slots[i]!.class}`} giro={slots[i]!.giro} ordem={i} hero />)}
    </div>
  </div>
</section>
