---
import { linhaDeLetras } from '../../lib/arte.ts';

interface Props {
  // The artist name, e.g. "TazTheDoctor": the first word big, the rest as a smaller line.
  nome: string;
  class?: string;
}

const { nome, class: classe } = Astro.props;
const partes = nome.match(/[A-Z][a-z]*/g) ?? [nome];
const [primeira, resto] = partes.length > 1 ? [partes[0]!, partes.slice(1).join('')] : [nome, ''];

// Line 1 at full size, line 2 at 45%, both centred; the margin leaves room for the 3D block.
const ESCALA_2 = 0.45;
const MARGEM = 4.5;
const medida1 = linhaDeLetras(primeira).largura;
const medida2 = resto ? linhaDeLetras(resto, { escala: ESCALA_2 }).largura : 0;
const largura = Math.max(medida1, medida2) + MARGEM * 2;
const linha1 = linhaDeLetras(primeira, { x: (largura - medida1) / 2, y: MARGEM, semente: 11 });
const linha2 = resto ? linhaDeLetras(resto, { x: (largura - medida2) / 2, y: MARGEM + 13.2, escala: ESCALA_2, semente: 23 }) : null;
const altura = MARGEM * 2 + (linha2 ? 13.2 + 10 * ESCALA_2 : 10) + 1.5;
const viewBox = `0 0 ${Math.round(largura * 10) / 10} ${Math.round(altura * 10) / 10}`;
const camadas = [
  { classe: 'tu-bloco', deslocamento: 'translate(1.3 1.5)' },
  { classe: 'tu-corte', deslocamento: '' },
  { classe: 'tu-contorno', deslocamento: '' },
];
// Letters keep their order across layers (--i), so each one paints all its layers together.
const letras = (linha: typeof linha1, inicio: number) => linha.tracos.map((t, i) => ({ ...t, i: inicio + i }));
const todas = [...letras(linha1, 0), ...(linha2 ? letras(linha2, linha1.tracos.length) : [])];
const recheio1 = letras(linha1, 0);
const recheio2 = linha2 ? letras(linha2, linha1.tracos.length) : [];
---

{/*
  Throw-up of the artist name, built from stroked letter skeletons (src/lib/arte.ts): amber 3D
  block, cream cut line, dark outline, spray and mint fills and a short shine on each stroke.
  Decorative: the name is written as text right next to it.
*/}
<svg class:list={['throw-up', classe]} viewBox={viewBox} aria-hidden="true" focusable="false">
  {
    camadas.map((camada) => (
      <g class={camada.classe} transform={camada.deslocamento || undefined}>
        {todas.map((t) => (
          <path class="desenha" d={t.d} transform={t.transform} pathLength="1" style={`--j:${t.i}`} />
        ))}
      </g>
    ))
  }
  <g class="tu-recheio">
    {recheio1.map((t) => <path class="desenha" d={t.d} transform={t.transform} pathLength="1" style={`--j:${t.i}`} />)}
  </g>
  <g class="tu-recheio tu-recheio-2">
    {recheio2.map((t) => <path class="desenha" d={t.d} transform={t.transform} pathLength="1" style={`--j:${t.i}`} />)}
  </g>
  <g class="tu-brilho" transform="translate(-0.45 -0.5)">
    {todas.map((t) => <path d={t.d} transform={t.transform} pathLength="1" />)}
  </g>
  {/* Two sparkles, the classic shine marks of a piece. */}
  <g class="tu-faisca">
    <path d={`M${largura - 3.2} 1.2 l0.5 1.6 l1.6 0.5 l-1.6 0.5 l-0.5 1.6 l-0.5 -1.6 l-1.6 -0.5 l1.6 -0.5 Z`} />
    <path d="M2.4 8.6 l0.35 1.1 l1.1 0.35 l-1.1 0.35 l-0.35 1.1 l-0.35 -1.1 l-1.1 -0.35 l1.1 -0.35 Z" />
  </g>
</svg>
