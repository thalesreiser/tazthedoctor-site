---
import ACompletar from './ACompletar.astro';
import Player from './Player.astro';
import TituloSecao from './TituloSecao.astro';
import Adesivo from './arte/Adesivo.astro';
import { ancoraSecao, type SecaoDo } from '../lib/schema.ts';

interface Props {
  secao: SecaoDo<'musica'>;
  rotulo: string;
  cor: string;
  emConstrucao: boolean;
}

const { secao, rotulo, cor, emConstrucao } = Astro.props;
const ancora = ancoraSecao(secao);
const idTitulo = `${ancora}-titulo`;
---

<section id={ancora} class="secao" aria-labelledby={idTitulo}>
  <div class="container-site relative">
    {/* Cassette sticker beside the title (content/site.json, musica.adesivos). */}
    {secao.adesivos[0] && <Adesivo adesivo={secao.adesivos[0]} class="absolute top-0 right-4 w-28 sm:right-8 sm:w-40" giro={6} />}
    <TituloSecao id={idTitulo} rotulo={rotulo} titulo={secao.titulo} subtitulo={secao.subtitulo} />
    <p class="mt-4 flex items-center gap-2 font-mono text-xs text-texto-suave">
      <span class="led-rec" aria-hidden="true"></span>
      {secao.aviso_players}
    </p>
    <div class="mt-12 grid grid-cols-2 gap-5 sm:gap-7 lg:grid-cols-4" data-revelar-grupo>
      {secao.itens.map((item) => <Player item={item} cor={cor} />)}
    </div>
    {secao.nota && <p class="mt-10 font-titulo text-2xl text-texto uppercase sm:text-3xl">{secao.nota}</p>}
    {
      /* Tracks in the making: no date, no link, no player; a dashed edge marks them as unfinished. */
      secao.em_producao && (
        <div class="mt-14">
          <h3 class="flex items-center gap-2 font-mono text-sm font-semibold tracking-[0.2em] text-destaque-frio uppercase">
            <span class="led-rec" aria-hidden="true"></span>
            {secao.em_producao.titulo}
          </h3>
          <ul class="mt-6 grid gap-5 md:grid-cols-3 md:gap-6" data-revelar-grupo>
            {secao.em_producao.itens.map((item) => (
              <li class="em-producao h-full p-6">
                <p class="font-mono text-xs tracking-[0.15em] text-texto-suave uppercase">{item.estilo}</p>
                <h4 class="mt-3 text-2xl font-bold break-words text-texto">{item.titulo}</h4>
                <p class="mt-3 text-texto-suave">{item.texto}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <ACompletar itens={secao.a_completar} emConstrucao={emConstrucao} />
  </div>
</section>
